# ── Ollama config ──────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Model ──────────────────────────────────────────────────────────────────────
# llama3.2:1b  → fastest, good for Q&A  (recommended)
# llama3.2     → balanced quality
# mistral      → best quality, slower
MODEL=llama3.2:1b

# ── Bot identity ───────────────────────────────────────────────────────────────
COMPANY_NAME=Danish Jalbani
BOT_NAME=Danish's Assistant

# ── Extra persona text appended to the system prompt ──────────────────────────
COMPANY_PERSONA=You represent Danish Jalbani, a professional web developer and consultant with 15+ years of experience. Always guide clients to reach out at danishjalbani.com.

# ── CORS ───────────────────────────────────────────────────────────────────────
# Use * for local dev. Set your real domain for production.
ALLOWED_ORIGINS=https://danishjalbani.com,https://www.danishjalbani.com
